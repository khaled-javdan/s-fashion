{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @workspace/db run deploy && turbo run build",
  "crons": [
    {
      "path": "/api/cron/retry-notifications",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/abandoned-checkout",
      "schedule": "*/15 * * * *"
    }
  ]
}
